<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B2A38">

    <!-- 1. HEADER NAVY (Tinggi Pas 145dp & Teks Ketengahan Agak Atas) -->
    <RelativeLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="145dp"
        android:background="#1B2A38">

        <!-- Motif Biji Kopi Terpisah Kanan Atas & Samping -->
        <ImageView
            android:layout_width="190dp"
            android:layout_height="145dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:scaleType="fitXY"
            android:src="@drawable/ic_beans_pattern" />

        <!-- Title Header (Posisi Ketengahan Pas & Font Serif Mewah) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="serif"
            android:text="Let's get you signed in!"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 2. WADAH PAPAN PUTIH MENJUNTAI KE BAWAH -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_layout"
        android:layout_marginTop="-25dp"
        android:background="@drawable/bg_sheet_white"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="22dp">

        <!-- Tab Container (Sign In / Register) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_tab_container"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_active"
                android:gravity="center"
                android:text="Sign In"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_switch_register"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Register"
                android:textColor="#64748B"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Input Username (Icon Orang) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_input_field">

            <ImageView
                android:id="@+id/iv_person_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_person"
                app:tint="#94A3B8" />

            <EditText
                android:id="@+id/et_email"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/iv_person_icon"
                android:background="@null"
                android:hint="Username"
                android:inputType="textPersonName"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:textColor="#1E293B"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />
        </RelativeLayout>

        <!-- Input Password (HANYA 1 ICON GEMBOK DI KANAN) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_field">

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@id/iv_toggle_password"
                android:background="@null"
                android:hint="Password"
                android:inputType="textPassword"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:textColor="#1E293B"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/iv_toggle_password"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_lock"
                app:tint="#94A3B8" />
        </RelativeLayout>

        <!-- Forgot Password -->
        <TextView
            android:id="@+id/tv_forgot_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:text="Forgot Password?"
            android:textColor="#FF5436"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Tombol Login Navy -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:text="Login"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#1B2A38"
            app:cornerRadius="27dp" />

        <!-- Divider Line: Or login with -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#FFECE6" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="Or login with"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#FFECE6" />
        </LinearLayout>

        <!-- Social Buttons Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Facebook Card -->
            <LinearLayout
                android:id="@+id/btn_social_facebook"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_social_card"
                android:gravity="center">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_facebook" />
            </LinearLayout>

            <!-- Google Card HD -->
            <LinearLayout
                android:id="@+id/btn_social_google"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_social_card"
                android:gravity="center">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_google" />
            </LinearLayout>

            <!-- Apple Card -->
            <LinearLayout
                android:id="@+id/btn_social_apple"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_social_card"
                android:gravity="center">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_apple" />
            </LinearLayout>
        </LinearLayout>

        <!-- Footer Text -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textColor="#64748B"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_footer_register"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Register Now"
                android:textColor="#FF5436"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>